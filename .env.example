# Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/everything

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
# The bucket name must include the APPID, e.g. mydata-1250000000
COS_BUCKET=
COS_REGION=ap-guangzhou

# Runtime environment: development (default) or production
# production adds Secure to cookies and refuses to send verification codes when SES is unconfigured
APP_ENV=development

# Listen address. ADDR wins; setting only PORT is equivalent to ":PORT"
# ADDR=127.0.0.1:8080
PORT=8080

# Optional: frontend build output directory; auto-discovers web/dist when empty
# WEB_DIR=web/dist

# User system
# Session lifetime in days, default 30
SESSION_TTL_DAYS=30
# Production defaults to a Secure cookie; set this to false if login does not stick over local http
# COOKIE_SECURE=false
# Set to false to disable registration (recommended once you have registered your own account)
ALLOW_REGISTRATION=true

# Tencent Cloud SES: sign-in / sign-up / email-change verification codes
# When unset, development logs the code and auto-fills it on the login page; production refuses to send
# SES_SECRET_ID / SES_SECRET_KEY fall back to COS_SECRET_ID / COS_SECRET_KEY when empty
SES_REGION=ap-guangzhou
# May include a display name: display name + one space + <email address>
SES_FROM_EMAIL_ADDRESS=
SES_TEMPLATE_ID=
# Optional Chinese template; the email language follows the browser's Accept-Language header
SES_TEMPLATE_ID_ZH=
SES_TEMPLATE_VAR=code
SES_SUBJECT=Everything About Me verification code
SES_SUBJECT_ZH=Everything About Me 验证码
SES_REPLY_TO_ADDRESS=

# Stream (automatic photo/video organization, health data band)
# Turn off the background organizer to keep read-only endpoints
TIMELINE_ENABLED=true
# Background concurrency
TIMELINE_WORKERS=2
# Display budget per month in units (1 unit ≈ 72px), default 24
TIMELINE_MONTH_BUDGET=24
# Which day an event's time is bucketed into
TIMELINE_TZ=Asia/Shanghai
