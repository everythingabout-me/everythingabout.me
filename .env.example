# Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/everything

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
# 桶名必须带 APPID，例如 mydata-1250000000
COS_BUCKET=
COS_REGION=ap-guangzhou

# 运行环境：development（默认）或 production
# production 会给 cookie 加 Secure；没配 SES 时拒绝发送验证码
APP_ENV=development

# 监听地址。ADDR 优先；只写 PORT 时等价于 ":PORT"
# ADDR=127.0.0.1:8080
PORT=8080

# 可选：前端构建产物目录；不填时自动找 web/dist
# WEB_DIR=web/dist

# 用户系统
# 登录态有效期（天），默认 30
SESSION_TTL_DAYS=30
# 正式环境默认 Secure cookie；本地 http 调试若登录态不生效可设为 false
# COOKIE_SECURE=false
# 设为 false 关闭注册（个人实例注册完自己后建议关掉）
ALLOW_REGISTRATION=true

# 腾讯云 SES：登录 / 注册 / 改邮箱验证码
# 不填时，开发环境把验证码打到服务端日志并在登录页自动填入；生产环境会拒绝发送
# SES_SECRET_ID / SES_SECRET_KEY 不填则复用 COS_SECRET_ID / COS_SECRET_KEY
SES_REGION=ap-guangzhou
# 可以带显示名，格式：显示名 + 一个空格 + <邮箱地址>
SES_FROM_EMAIL_ADDRESS=
SES_TEMPLATE_ID=
SES_TEMPLATE_VAR=code
SES_SUBJECT=Everything About Me 验证码
SES_REPLY_TO_ADDRESS=

# 内容流（照片/视频自动整理、健康数据带）
# 关掉后台整理只保留读接口
TIMELINE_ENABLED=true
# 后台并发数
TIMELINE_WORKERS=2
# 一个月最多占多少展示单位（1 单位 ≈ 72px），默认 24
TIMELINE_MONTH_BUDGET=24
# 把事件时间归到哪一天
TIMELINE_TZ=Asia/Shanghai
