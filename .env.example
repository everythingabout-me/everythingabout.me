# Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/everything

# Application identity (required for server startup; keep stable across storage/DB changes)
# New install: generate a random secret and back it up independently.
# Upgrade: set this to the previous COS_SECRET_KEY signing seed, or the previous DATABASE_URL
# if the old deployment had no COS key. Preserve the exact seed before rotating credentials.
APP_SECRET=

# File API cookie origins (comma-separated explicit origins; no paths or wildcard)
# Development defaults: http://localhost:5173,http://127.0.0.1:5173
# Production has no default; configure the canonical browser/API origin explicitly.
# FILE_COOKIE_ORIGINS=https://everything.example

# Storage backend: cos (legacy runtime default), local, or s3
# Unified reads work on all three. Writes require an explicit verified owner baseline.
# Object writes additionally require isolated native probe evidence for the exact connection.
# FILE_OBJECT_ADMISSION_FILE=/secure/storage-capabilities.json
# FILE_OBJECT_SPOOL_ROOT=/srv/everything/object-spool
# Object storage-admit also requires --physical-bytes N including retained versions and
# baseline evidence.retainedVersionInventory. See README "COS connection admission".
# Set true after verifying native create/write capabilities and the owner baseline.
# An object report with createOnly:true admits new files without bucket versioning
# or exclusive external writers; it rejects overwrite and destructive actions.
# Its storage-admit invocation can omit --writers-quiesced. The broader Local or
# versioned object strategy still requires coordinated exclusive native writers:
# `eam storage-admit --owner-id UUID --writers-quiesced --evidence /secure/proof.json`.
# Local first admission needs an empty system owner directory; object admission an empty
# binding spool. Run admission before serving writes.
FILE_COORDINATED_WRITES=false
FILE_MAX_SINGLE_PUT_BYTES=33554432
# embedded: self-hosted application receives numbered upload parts.
# edgeone: official COS mode. Application signs narrow short-lived part requests;
# the browser PUTs to /api/files/transfer/<object-key>?<signed-query> on this origin.
# EdgeOne ordinary forwarding strips /api/files/transfer, sets the COS bucket Host,
# preserves the full signed query/Content-MD5/Content-Type/Content-Length, and sends
# bytes directly to COS. No edge function or separate upload server is needed.
# Configure multipartUploads + signedMultipartParts evidence for the exact bucket.
# Control endpoints including authorize/confirm/commit stay on the application.
# Old external ingress is rejected; drain old sessions/grants before cutover.
FILE_UPLOAD_INGRESS=embedded
STORAGE_BACKEND=cos
STORAGE_CONNECTION_ID=default
STORAGE_GENERATION=1
# Existing absolute directories, with an existing <owner-UUID>/ child under each:
# LOCAL_CONTENT_ROOT=/srv/everything/content
# LOCAL_SYSTEM_ROOT=/srv/everything/system
# Conservative false; assert true only after checking the actual filesystem semantics.
LOCAL_CASE_SENSITIVE=false
# Generic S3 uses explicit endpoint/region/auth and never COS settings:
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=everything
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
S3_PATH_STYLE=false
S3_CONTENT_PREFIX=drive/
S3_SYSTEM_PREFIX=__eam_system__/

# Tencent Cloud COS (used only by the COS backend and explicit COS maintenance commands)
COS_SECRET_ID=
COS_SECRET_KEY=
# The bucket name must include the APPID, e.g. mydata-1250000000
COS_BUCKET=
COS_REGION=ap-guangzhou
# Required only with FILE_UPLOAD_INGRESS=edgeone: a DIFFERENT CAM sub-account/key
# whose effective policy allows ONLY name/cos:UploadPart on the configured root.
# It must not inherit UploadPartCopy, PutObject, CompleteMultipartUpload or DeleteObject.
# Secrets stay server-side. Test effective policy with unsigned x-cos-copy-source negatives.
# COS_UPLOAD_SIGN_SECRET_ID=
# COS_UPLOAD_SIGN_SECRET_KEY=

# Runtime environment: development (default) or production
# production adds Secure to cookies and refuses to send verification codes when SES is unconfigured
APP_ENV=development

# Listen address. ADDR wins; setting only PORT is equivalent to ":PORT"
# ADDR=127.0.0.1:8080
PORT=8080

# Optional: frontend build output directory; auto-discovers web/dist when empty
# WEB_DIR=web/dist

# User system
# Session lifetime in days, default 30
SESSION_TTL_DAYS=30
# Production defaults to a Secure cookie; set this to false if login does not stick over local http
# COOKIE_SECURE=false
# Set to false to disable registration (recommended once you have registered your own account)
ALLOW_REGISTRATION=true

# Tencent Cloud SES: sign-in / sign-up / email-change verification codes
# When unset, development logs the code and auto-fills it on the login page; production refuses to send
# Explicit credentials are required for production email; no COS fallback.
SES_SECRET_ID=
SES_SECRET_KEY=
SES_REGION=ap-guangzhou
# May include a display name: display name + one space + <email address>
SES_FROM_EMAIL_ADDRESS=
SES_TEMPLATE_ID=
# Optional Chinese template; the email language follows the browser's Accept-Language header
SES_TEMPLATE_ID_ZH=
SES_TEMPLATE_VAR=code
SES_SUBJECT=Everything About Me verification code
SES_SUBJECT_ZH=Everything About Me 验证码
SES_REPLY_TO_ADDRESS=

# Stream (automatic photo/video organization, health data band)
# Turn off the background organizer to keep read-only endpoints
TIMELINE_ENABLED=true
# Background concurrency
TIMELINE_WORKERS=2
# Display budget per month in units (1 unit ≈ 72px), default 24
TIMELINE_MONTH_BUDGET=24
# Which day an event's time is bucketed into
TIMELINE_TZ=Asia/Shanghai
